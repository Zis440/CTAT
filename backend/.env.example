# ==========================================
# Psyichub - Backend Environment Config
# ==========================================

# ── Database Configuration ────────────────
DATABASE_URL=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=

# ── Security & JWT Auth ───────────────────
CT_SECRET_KEY=psyichub-dev-secret-change-in-production-32chars!
CT_ALGORITHM=HS256
CT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Server Configuration ──────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
CRON_SECRET=psyichub-cron-secret-change-in-production

# ── Razorpay (Payments & Wallet) ──────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (Email Notifications) ──────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Firebase (Phone OTP Verification) ─────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# ── OAuth Providers ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
MICROSOFT_TENANT=common

# ── Neurofy Integration ───────────────────
NEUROFY_API_KEY=
NEUROFY_API_URL=https://neurofy.app/api
NEUROFY_TIMEOUT=30
