# ── DATABASE CONFIGURATION ────────────────────────────────────────────────────
# PostgreSQL connection (local development)
DATABASE_URL=#

# PostgreSQL Credentials (used by docker-compose)
DB_NAME=#
DB_USER=#
DB_PASSWORD=#
DB_HOST=#
DB_PORT=5432

# ── JWT Authentication ────────────────────────────────────────────────────────
CT_SECRET_KEY=#
CT_ALGORITHM=#
CT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=#
RAZORPAY_KEY_SECRET=#

# ── Groq Cloud LLM Integration (Render / Production) ──────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Ollama Integration (Local Development) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Nerotix (eKYC) Document Verification ──────────────────────────────────────
# API docs: https://documenter.getpostman.com/view/36420570/2sBXwnsreF
NEUROFY_API_KEY=#
NEUROFY_API_URL=https://api.nerofy.in
NEUROFY_TIMEOUT=30

# ── Firebase Auth (Phone OTP Verification) ────────────────────────────────────
# Get these from Firebase Console → Project Settings
FIREBASE_PROJECT_ID=#
FIREBASE_WEB_API_KEY=#
FIREBASE_AUTH_DOMAIN=#
FIREBASE_APP_ID=#
FIREBASE_SERVICE_ACCOUNT_PATH=#
# For dev mode: leave FIREBASE_SERVICE_ACCOUNT_PATH empty — OTP will be simulated

# ── Resend Email Service ──────────────────────────────────────────────────────
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=#
RESEND_FROM_EMAIL=CoreThematics <noreply@corethematics.com>
# For dev mode: leave RESEND_API_KEY empty — emails will be logged to console

# ── Razorpay Bank Verification ────────────────────────────────────────────────
# Get API keys from https://dashboard.razorpay.com/app/keys
# For dev mode: leave empty — bank verification will be simulated